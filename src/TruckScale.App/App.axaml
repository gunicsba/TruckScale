<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TruckScale.App.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="124" />
      <Setter Property="Height" Value="88" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="TextBox.ro">
      <Setter Property="Background" Value="#eeeeee" />
      <Setter Property="BorderBrush" Value="#dddddd" />
    </Style>
    <Style Selector="TextBox.ro:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#eeeeee" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#666" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Styles>
</Application>
