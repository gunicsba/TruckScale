<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:TruckScale.App"
        x:Class="TruckScale.App.MainWindow"
        Title="Truck Scale"
        Width="1200" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{l:T main.menu.file}">
        <MenuItem Header="{l:T main.in}" Click="OnIn" />
        <MenuItem Header="{l:T main.out}" Click="OnOut" />
        <Separator />
        <MenuItem Header="{l:T main.exit}" Click="OnExit" />
      </MenuItem>
      <MenuItem x:Name="LanguageMenu" Header="{l:T main.menu.language}" />
      <MenuItem Header="{l:T main.menu.help}">
        <MenuItem Header="{l:T main.menu.about}" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" BorderBrush="#ccc" BorderThickness="0,0,0,1" Padding="4">
      <WrapPanel>
        <Button Classes="tool" Click="OnIn" ToolTip.Tip="{l:T main.tip.in}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <PathIcon Width="40" Height="40" Foreground="#2f6fd6" Data="F1 M9,2 H15 V12 H20 L12,21 L4,12 H9 Z" />
            <TextBlock Text="{l:T main.in}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Click="OnOut" ToolTip.Tip="{l:T main.tip.out}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <PathIcon Width="40" Height="40" Foreground="#2f6fd6" Data="F1 M12,2 L20,11 H15 V21 H9 V11 H4 Z" />
            <TextBlock Text="{l:T main.out}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Click="OnLog" ToolTip.Tip="{l:T main.tip.log}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <PathIcon Width="40" Height="40" Foreground="#d4a017" Data="F1 M3,4 H21 V7 H3 Z M3,10.5 H21 V13.5 H3 Z M3,17 H21 V20 H3 Z" />
            <TextBlock Text="{l:T main.log}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Click="OnSummary" ToolTip.Tip="{l:T main.tip.summary}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <PathIcon Width="40" Height="40" Foreground="#2f6fd6" Data="F1 M5,3 H19 V7.5 H17 V5.5 H9.2 L14,12 L9.2,18.5 H17 V16.5 H19 V21 H5 V19.3 L10.6,12 L5,4.7 Z" />
            <TextBlock Text="{l:T main.summary}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Click="OnData" ToolTip.Tip="{l:T main.tip.data}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <PathIcon Width="40" Height="40" Foreground="#6a5acd" Data="M3,3 H21 V21 H3 Z M5,5 V9 H19 V5 Z M5,11 V14 H11 V11 Z M13,11 V14 H19 V11 Z M5,16 V19 H11 V16 Z M13,16 V19 H19 V16 Z" />
            <TextBlock Text="{l:T main.data}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Click="OnSettings" ToolTip.Tip="{l:T main.tip.settings}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <PathIcon Width="40" Height="40" Foreground="#2a9d4b" Data="F1 M3,5 H21 V7 H3 Z M3,11 H21 V13 H3 Z M3,17 H21 V19 H3 Z M6,2.5 H10 V9.5 H6 Z M14,8.5 H18 V15.5 H14 Z M8,14.5 H12 V21.5 H8 Z" />
            <TextBlock Text="{l:T main.settings}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Click="OnExit">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <PathIcon Width="40" Height="40" Foreground="#c0283c" Data="F1 M5,3 L12,10 L19,3 L21,5 L14,12 L21,19 L19,21 L12,14 L5,21 L3,19 L10,12 L3,5 Z" />
            <TextBlock Text="{l:T main.exit}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="#eee" BorderBrush="#ccc" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock x:Name="StatusText" Classes="hint" />
    </Border>

    <!-- Weight display + simulator -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8">
      <StackPanel x:Name="SimulatorPanel" Grid.Column="0" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0" IsVisible="False">
        <TextBlock Text="{l:T main.simulator}" FontWeight="SemiBold" />
        <Slider x:Name="SimSlider" Minimum="0" Maximum="60000" SmallChange="20" LargeChange="1000" />
        <WrapPanel x:Name="SimPresets" />
      </StackPanel>
      <Border x:Name="WeightHost" Grid.Column="1" Width="420" Height="120" />
    </Grid>

    <!-- Lists -->
    <TabControl Margin="8,0,8,8">
      <TabItem x:Name="YardTab" Header="">
        <DataGrid x:Name="YardGrid" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True" DoubleTapped="OnYardDoubleTapped" KeyDown="OnYardKeyDown">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{l:T f.direction}" Binding="{Binding DirectionText}" />
            <DataGridTextColumn Header="{l:T f.plate}" Binding="{Binding Plate}" />
            <DataGridTextColumn Header="{l:T f.customer}" Binding="{Binding PartnerName}" Width="2*" />
            <DataGridTextColumn Header="{l:T f.driver}" Binding="{Binding DriverName}" />
            <DataGridTextColumn Header="{l:T f.material}" Binding="{Binding MaterialName}" />
            <DataGridTextColumn Header="{l:T f.marking}" Binding="{Binding Marking}" />
            <DataGridTextColumn Header="{l:T f.firstKg}" Binding="{Binding FirstWeight, StringFormat='{}{0:N0}'}" />
            <DataGridTextColumn Header="{l:T f.arrived}" Binding="{Binding FirstAtText}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem x:Name="TodayTab" Header="">
        <DataGrid x:Name="TodayGrid" IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Single" GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                  DoubleTapped="OnTodayDoubleTapped" ToolTip.Tip="{l:T main.tip.today}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{l:T f.ticket}" Binding="{Binding TicketNo}" />
            <DataGridTextColumn Header="{l:T f.status}" Binding="{Binding StatusText}" />
            <DataGridTextColumn Header="{l:T f.direction}" Binding="{Binding DirectionText}" />
            <DataGridTextColumn Header="{l:T f.plate}" Binding="{Binding Plate}" />
            <DataGridTextColumn Header="{l:T f.customer}" Binding="{Binding PartnerName}" Width="2*" />
            <DataGridTextColumn Header="{l:T f.material}" Binding="{Binding MaterialName}" />
            <DataGridTextColumn Header="{l:T f.gross}" Binding="{Binding Gross, StringFormat='{}{0:N0}'}" />
            <DataGridTextColumn Header="{l:T f.tare}" Binding="{Binding Tare, StringFormat='{}{0:N0}'}" />
            <DataGridTextColumn Header="{l:T f.net}" Binding="{Binding Net, StringFormat='{}{0:N0}'}" />
            <DataGridTextColumn Header="{l:T f.closed}" Binding="{Binding ClosedTimeText}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
