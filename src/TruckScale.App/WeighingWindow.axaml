<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TruckScale.App.WeighingWindow"
        Title="Jármű érkezése"
        Width="940" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16" ColumnDefinitions="*,24,360" RowDefinitions="Auto,Auto">

    <!-- Left: what is being weighed -->
    <Grid Grid.Column="0" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
      <TextBlock Grid.Row="0" Classes="label" Text="Irány" />
      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="16">
        <RadioButton x:Name="DirIn" GroupName="dir" Content="Beszállítás" />
        <RadioButton x:Name="DirOut" GroupName="dir" Content="Kiszállítás" />
      </StackPanel>

      <TextBlock Grid.Row="1" Classes="label" Text="Ügyfél" />
      <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto">
        <AutoCompleteBox x:Name="PartnerBox" PlaceholderText="Név (gépeljen, vagy ▾)" />
        <Button Grid.Column="1" x:Name="PartnerList" Content="▾" Margin="4,0,0,0" />
      </Grid>
      <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PartnerInfo" Classes="hint" />

      <TextBlock Grid.Row="3" Classes="label" Text="Rendszám" />
      <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto">
        <AutoCompleteBox x:Name="PlateBox" PlaceholderText="pl. NLB381/YKK063" />
        <Button Grid.Column="1" x:Name="PlateList" Content="▾" Margin="4,0,0,0" />
      </Grid>
      <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="16">
        <TextBlock x:Name="TareInfo" Classes="hint" VerticalAlignment="Center" />
        <CheckBox x:Name="UseStoredTare" Content="Használ (tárolt tára, egy mérés)" />
      </StackPanel>

      <TextBlock Grid.Row="5" Classes="label" Text="Sofőr" />
      <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto">
        <AutoCompleteBox x:Name="DriverBox" PlaceholderText="Vezetéknév Keresztnév" />
        <Button Grid.Column="1" x:Name="DriverList" Content="▾" Margin="4,0,0,0" />
      </Grid>

      <TextBlock Grid.Row="6" Classes="label" Text="Anyag" />
      <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,Auto">
        <AutoCompleteBox x:Name="MaterialBox" PlaceholderText="pl. Árpa" />
        <Button Grid.Column="1" x:Name="MaterialList" Content="▾" Margin="4,0,0,0" />
      </Grid>
      <TextBlock Grid.Row="7" Grid.Column="1" x:Name="MaterialInfo" Classes="hint" />

      <TextBlock Grid.Row="8" Classes="label" Text="Megjelölés" />
      <TextBox Grid.Row="8" Grid.Column="1" x:Name="MarkingBox" PlaceholderText="szabad szöveg (nem kötelező)" />
    </Grid>

    <!-- Right: weights -->
    <StackPanel Grid.Column="2" Spacing="8">
      <StackPanel x:Name="FirstPanel" Spacing="2" IsVisible="False">
        <TextBlock Text="1. mérés" FontWeight="SemiBold" />
        <TextBlock x:Name="FirstInfo" FontSize="18" />
      </StackPanel>
      <TextBlock x:Name="WeightTitle" Text="Össztömeg" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <Border x:Name="WeightHost" Height="110" />
      <TextBlock x:Name="HintText" Classes="hint" TextWrapping="Wrap" Foreground="#a33" MinHeight="34" />
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="VoidButton" Content="Stornó (törlés)" MinWidth="120" IsVisible="False" Foreground="#a00" />
      <Button x:Name="CancelButton" Content="Mégse" MinWidth="100" IsCancel="True" />
      <Button x:Name="WeighButton" Content="Mérés" MinWidth="140" Height="40" FontSize="16" FontWeight="Bold" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
